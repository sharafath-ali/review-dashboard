# PostgreSQL Connection URL (Required for local development outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reviewdash

# Rainforest API Key (Required for review fetching)
# Get a key at https://www.rainforestapi.com/
RAINFOREST_API_KEY=your_rainforest_api_key_here
# Shared API Bearer Token (Required for API authorization)
# Set a secret key of your choice to protect `/api/ingest`, `/api/reviews`, and `/api/products` endpoints.
# When requesting, pass it in headers as: Authorization: Bearer your_shared_bearer_token_here
INGEST_SECRET=your_shared_bearer_token_here